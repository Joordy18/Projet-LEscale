# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://lescale:lescale_dev@localhost:5432/lescale

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lescale

# Auth.js : générer un secret avec « npx auth secret » ou « openssl rand -base64 32 »
AUTH_SECRET=replace-with-a-long-random-secret

# Photos téléversées par les gestionnaires (dossier créé au besoin)
UPLOAD_DIR=./.uploads

# Tâche planifiée d'expiration des demandes (R8) : POST /api/jobs/expire-requests avec « Authorization: Bearer <secret> »
CRON_SECRET=replace-with-another-long-secret

# Jeu d'essai (npm run db:seed) : mot de passe des comptes de démonstration, à ne jamais utiliser en production
SEED_PASSWORD=Escale-demo-2026!

# Affiche les comptes de démonstration sur la page de connexion (environnement de démonstration uniquement)
SHOW_DEMO_ACCOUNTS=false

# Tests d'intégration (bases dédiées, créées avec « create database lescale_test »)
DATABASE_URL_TEST=postgresql://lescale:lescale_dev@localhost:5432/lescale_test
MONGODB_URI_TEST=mongodb://localhost:27017/lescale_test
