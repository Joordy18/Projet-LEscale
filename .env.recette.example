# Variables de l'environnement de recette (copier en .env.recette, ne jamais le commiter).
# Générer les secrets avec : openssl rand -base64 32

# Adresse publique de l'application (HTTPS)
APP_URL=https://recette.lescale.example
APP_PORT=3000

# Image publiée par la CI (facultatif ; sinon l'image est construite sur place)
APP_IMAGE=ghcr.io/joordy18/projet-lescale:master
MIGRATE_IMAGE=ghcr.io/joordy18/projet-lescale-migrate:master

POSTGRES_USER=lescale
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long
POSTGRES_DB=lescale

AUTH_SECRET=remplacer-par-un-secret-aleatoire
CRON_SECRET=remplacer-par-un-autre-secret-aleatoire
